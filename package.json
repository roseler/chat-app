{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "End-to-end encrypted chat application",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "deploy:cf": "wrangler deploy",
    "login:cf": "wrangler login",
    "test:deploy": "node --test cloudflare/test/*.test.mjs",
    "dev:cloudflare": "wrangler dev --port 8787",
    "test:cloudflare": "node --test cloudflare/test/integration.mjs"
  },
  "keywords": [
    "chat",
    "encryption",
    "messaging"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.9.10",
    "wrangler": "^4.151.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "validator": "^13.15.35"
  }
}
